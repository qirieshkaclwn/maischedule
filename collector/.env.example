# Куда отправлять снапшот — эндпоинт приёма на вашем сервере
INGEST_URL=https://schedule.example.com/internal/ingest

# Тот же токен, что INGEST_TOKEN в .env сервера. Сгенерировать: openssl rand -hex 32
INGEST_TOKEN=

# Физический интерфейс, чтобы ходить мимо VPN (например wlp2s0 или enp0s31f6)
BYPASS_INTERFACE=wlp2s0

# Период успешных отправок и пауза после неудачи
INTERVAL_HOURS=24
RETRY_MINUTES=15

# Сколько расписаний качать параллельно
CONCURRENCY=6

# Уровень логов
RUST_LOG=mai_collector=info
