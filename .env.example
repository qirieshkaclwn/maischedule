# Telegram Bot Token от @BotFather (обязательно для работы бота и уведомлений)
BOT_TOKEN=your_bot_token_here

# ID чата или пользователя в Telegram для отправки уведомлений по умолчанию (опционально)
# Можно оставить пустым — пользователи подписываются через бота командой /start
TELEGRAM_CHAT_ID=

# Группа по умолчанию для синхронизации календаря и сервера
DEFAULT_GROUP=М3О-309БВ-24

# Настройки HTTP сервера для генерации Webcal подписки
HOST=0.0.0.0
PORT=8000

# Публичный URL вашего сервера (нужен для генерации ссылки webcal:// в боте)
# Например: https://schedule.example.com или http://<IP_VPS>:8000
BASE_URL=http://0.0.0.0:8000

# Интервал проверки изменений расписания (в минутах)
CHECK_INTERVAL_MINUTES=30

# Путь к файлу базы данных SQLite
DB_PATH=data/maischedule.db

# Часовой пояс
TIMEZONE=Europe/Moscow

# Напоминание в календаре (за сколько минут до начала пары показывать пуш на iPhone)
ALERT_MINUTES_BEFORE=15
