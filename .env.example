# Telegram Bot Token от @BotFather (обязательно для работы бота и уведомлений)
BOT_TOKEN=your_bot_token_here

# ID Telegram администратора (числовой chat_id). Дает доступ к кнопке выгрузки лога обновлений и админ-командам
TELEGRAM_CHAT_ID=


# Группа по умолчанию для синхронизации календаря и сервера
DEFAULT_GROUP=М14О-101БВ-26

# Доменное имя для сервиса и HTTPS (отдельный поддомен)
DOMAIN=schedule.example.com

# Email для уведомлений безопасности Let's Encrypt (опционально)
LETSENCRYPT_EMAIL=admin@example.com

# Настройки HTTP сервера для генерации Webcal подписки
HOST=0.0.0.0
PORT=8000

# Публичный HTTPS URL вашего сервера (нужен для генерации ссылок webcal:// и https:// в боте)
BASE_URL=https://schedule.example.com

# Интервал проверки изменений расписания для активных групп пользователей (в минутах)
CHECK_INTERVAL_MINUTES=30

# Периодичность фонового обновления расписаний для всех остальных групп МАИ (в часах, 12 = 2 раза в день)
ALL_GROUPS_SYNC_HOURS=12

# Путь к файлу базы данных SQLite
DB_PATH=data/maischedule.db

# Часовой пояс
TIMEZONE=Europe/Moscow

# Напоминание в календаре (за сколько минут до начала пары показывать пуш на iPhone)
ALERT_MINUTES_BEFORE=15
